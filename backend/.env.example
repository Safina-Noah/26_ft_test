DB_URL=jdbc:mariadb://localhost:3306/reponote
DB_USERNAME=reponote
DB_PASSWORD=
PORT=8080
FRONTEND_URL=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/login/oauth2/code/github
# Generate once. Base64 of 32 random bytes. Keep the same key across restarts.
TOKEN_ENCRYPTION_KEY=
AI_BASE_URL=https://open.hasa.re.kr/v1
AI_API_KEY=
AI_MODEL=qwen3-coder
# Turn on only after confirming this model accepts response_format=json_schema.
AI_STRUCTURED_OUTPUT=false
AI_MAX_OUTPUT_TOKENS=12000
ANALYSIS_MAX_FILES=24
ANALYSIS_MAX_FILE_BYTES=60000
ANALYSIS_MAX_INPUT_CHARS=90000
ANALYSIS_MAX_COMMITS=20
COOKIE_SECURE=false

# Enable once only after checking an existing schema has no RepoNote table-name conflicts.
DB_FLYWAY_BASELINE_ON_MIGRATE=false
