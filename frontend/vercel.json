{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://two6-ft-test.onrender.com/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://two6-ft-test.onrender.com/oauth2/:path*"
    },
    {
      "source": "/login/:path*",
      "destination": "https://two6-ft-test.onrender.com/login/:path*"
    }
  ]
}
